                },
                {
                    "Text": "Ты снова здесь.",
                    "RequiredQuestID": 104,
                    "RequiredState": "COMPLETED"
                },
                {
                    "Text": "Вернулся. Ну что там?",
                    "RequiredQuestID": 106,
                    "RequiredState": "CAN_TURNIN"
                },
                {
                    "Text": "Ну как прошло?",
                    "RequiredQuestID": 106,
                    "RequiredState": "STARTED"
                }
            ],
            "Responses": [
                {
                    "Text": "Я отнес семена. Доктор и Климентина посмотрели.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 106,
                    "RequiredQuestState": "STARTED",
                    "RequiredItemClassName": "CP_CannabisSeedsPurpleKush",
                    "ActionType": "TALK_DONE",
                    "SubFile": "quest_106.json",
                    "FileNodeID": 106002
                },
                {
                    "Text": "Призрак, Петрович сказал зайти. Говорит, у тебя дело.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 106,
                    "RequiredQuestState": "NONE",
                    "ActionType": "NONE",
                    "SubFile": "quest_106.json",
                    "FileNodeID": 106001
                },
                {
                    "Text": "Петрович сказал найти тебя.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 104,
                    "RequiredQuestState": "STARTED",
                    "ActionType": "NONE",
                    "SubFile": "quest_104.json"
                },
                {
                    "Text": "Я разобрался с тем местом.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 106,
                    "RequiredQuestState": "CAN_TURNIN",
                    "ActionType": "NONE",
                    "SubFile": "quest_106.json",
                    "FileNodeID": 106003
                },
                {
                    "Text": "Петрович говорит, ты знал про «Новый Рассвет» и молчал.",
                    "NextNodeID": 5,
                    "RequiredQuestID": 107,
                    "RequiredQuestState": "COMPLETED",
                    "ActionType": "NONE"
                },
                {
                    "Text": "Ты кто?",
                    "NextNodeID": 2,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Чего молчишь?",
                    "NextNodeID": 3,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Ну и молчи.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                },
                {
                    "Text": "Фанатики опять дымят завод?",
                    "NextNodeID": -1,
                    "RequiredQuestID": 201,
                    "RequiredQuestState": "COMPLETED",
                    "ActionType": "NONE",
                    "SubFile": "quest_1004.json",
                    "FileNodeID": 1004001
                },
                {
                    "Text": "Ты говорил про их маски. Что с ними?",
                    "NextNodeID": -1,
                    "RequiredQuestID": 202,
                    "RequiredQuestState": "NONE",
                    "ActionType": "NONE",
                    "SubFile": "quest_202.json",
                    "FileNodeID": 202001
                },
                {
                    "Text": "Есть что-то новое, Призрак?",
                    "NextNodeID": -1,
                    "RequiredQuestID": 203,
                    "RequiredQuestState": "NONE",
                    "ActionType": "NONE",
                    "SubFile": "quest_203.json",
                    "FileNodeID": 203001
                },
                {
                    "Text": "Я принёс волокна.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 203,
                    "RequiredQuestState": "CAN_TURNIN",
                    "ActionType": "NONE",
                    "SubFile": "quest_203.json",
                    "FileNodeID": 203003
                },
                {
                    "Text": "Я ещё ищу деревья.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 203,
                    "RequiredQuestState": "STARTED",
                    "ActionType": "NONE",
                    "SubFile": "quest_203.json",
                    "FileNodeID": 203001
                },
                {
                    "Text": "Я раздобыл маски. Доктор сказал — галлюциноген.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 202,
                    "RequiredQuestState": "CAN_TURNIN",
                    "ActionType": "NONE",
                    "SubFile": "quest_202.json",
                    "FileNodeID": 202002
                },
                {
                    "Text": "Я ещё собираю маски.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 202,
                    "RequiredQuestState": "STARTED",
                    "ActionType": "NONE",
                    "SubFile": "quest_202.json",
                    "FileNodeID": 202001
                },
                {
                    "Text": "На заводе чисто.",
                    "NextNodeID": -1,
                    "RequiredQuestID": 1004,
                    "RequiredQuestState": "CAN_TURNIN",
                    "ActionType": "NONE",
                    "SubFile": "quest_1004.json",
                    "FileNodeID": 1004002
                },
                {
                    "Text": "По поводу завода...",
                    "NextNodeID": -1,
                    "RequiredQuestID": 1004,
                    "RequiredQuestState": "STARTED",
                    "ActionType": "NONE",
                    "SubFile": "quest_1004.json",
                    "FileNodeID": 1004001
                },
                {
                    "Text": "Есть что предложить?",
                    "NextNodeID": 16,
                    "RequiredQuestID": 105,
                    "RequiredQuestState": "COMPLETED",
                    "ActionType": "NONE"
                }
            ]
        },
        {
            "ID": 2,
            "Type": "STANDARD",
            "SpeakerText": "Призрак. Меня так зовут все. Я здесь недавно. Видел, как лагерь строился, как люди приходили и уходили. Некоторые не возвращались.",
            "Responses": [
                {
                    "Text": "Почему Призрак?",
                    "NextNodeID": 4,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Жутковато тут у тебя.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 3,
            "Type": "STANDARD",
            "SpeakerText": "Говорить не люблю. Слова — шум. В этом мире лучше слушать, чем говорить.",
            "Responses": [
                {
                    "Text": "И что же ты слышишь?",
                    "NextNodeID": 4,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Понятно.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 4,
            "Type": "STANDARD",
            "SpeakerText": "Потому что я вижу то, чего другие не замечают. Шепот ветра, скрип деревьев. Этот мир говорит с теми, кто умеет слушать.",
            "Responses": [
                {
                    "Text": "Интересно. Ладно, бывай.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 5,
            "Type": "STANDARD",
            "SpeakerText": "Петрович — это порядок и стены. Услышь он про завод раньше времени — поднял бы охрану, пошёл бы туда толпой. И потерял бы людей. Эти — не те, с кем воюют строем. Я молчал, потому что знал больше, чем нужно всем. — Он отворачивается. — А теперь знает и Петрович... и ты. Ладно. Что сделано, то сделано. Держись подальше от их масок — и от вышки на севере.",
            "Responses": [
                {
                    "Text": "Что ты ещё скрываешь, Призрак?",
                    "NextNodeID": 3,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Понял. Бывай.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 16,
            "Type": "STANDARD",
            "SpeakerText": "Есть три места, до которых я добраться не смог. Не потому что далеко — а потому что там всё зашифровано. Военные схемы, кодовые замки, электронные ключи. Я собирал информацию годами. Карты, коды, обрывки записей. Всё это у меня есть. Бери — плати — владей.",
            "Responses": [
                {
                    "Text": "Покажи, что есть.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "SHOW_QUEST_LIST"
                },
                {
                    "Text": "В другой раз.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 17,
            "Type": "STANDARD",
            "SpeakerText": "Старый военный бункер. На картах не значится. Я нашёл его случайно — заросший вход, свежие следы. Кто-то там был, но не смог открыть. Внутри — запасы связистов: радиостанции, приборы ночного видения, может, оружие. Говорю «может» — потому что сам не вскрыл. Шифр первого уровня, но без кода — стена.",
            "Responses": [
                {
                    "Text": "Сколько стоит?",
                    "NextNodeID": -1,
                    "RequiredQuestID": 6001,
                    "RequiredQuestState": "NONE",
                    "ActionType": "SHOW_QUEST_LIST"
                },
                {
                    "Text": "Дороговато...",
                    "NextNodeID": 16,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Не интересует.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 18,
            "Type": "STANDARD",
            "SpeakerText": "Склад оружейный. Нелегальный, довоенный. Хозяева погибли, схрон остался. Я выменял часть карты у одного сталкера — он нашёл её в мёртвом городе. Говорил, там целый арсенал: автоматы, броня, боеприпасы. Но дверь — с электронным замком. Код я подобрал, проверять не ходил — берегу себя. Тебе он нужнее.",
            "Responses": [
                {
                    "Text": "Сколько стоит?",
                    "NextNodeID": -1,
                    "RequiredQuestID": 6002,
                    "RequiredQuestState": "NONE",
                    "ActionType": "SHOW_QUEST_LIST"
                },
                {
                    "Text": "Многовато...",
                    "NextNodeID": 16,
                    "RequiredQuestID": -1,
                    "ActionType": "NONE"
                },
                {
                    "Text": "Не интересует.",
                    "NextNodeID": -1,
                    "RequiredQuestID": -1,
                    "ActionType": "END_CONVERSATION"
                }
            ]
        },
        {
            "ID": 19,
            "Type": "STANDARD",
            "SpeakerText": "Самое жирное место. Элитный схрон — не знаю, кто его строил, но явно не рядовые военные. Трёхуровневая защита: код, биометрия, механический ключ. У меня есть все три части. Но цена высокая — потому что и риск, и награда максимальные. Там может быть всё что угодно: от образцов оружия до документов, переворачивающих историю этого мира.",
            "Responses": [
                {
                    "Text": "Сколько стоит?",
