            "SpeakerText": "...",
            "SpeakerTextConditions": [
                {
                    "Text": "Петрович приходил. Спрашивал про «Новый Рассвет». Это ты разболтал?.. Впрочем, неважно — всё равно пришлось бы рассказать.",
