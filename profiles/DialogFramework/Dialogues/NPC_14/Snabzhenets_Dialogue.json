          "RequiredQuestState": "COMPLETED",
          "ActionType": "END_CONVERSATION",
          "SubFile": "",
          "FileNodeID": -1
        }
      ]
    },
    {
      "ID": 4,
      "Type": "STANDARD",
      "SpeakerText": "Долг — не наказание, а опись. Лагерь отдал военным расписку за груз; не донёс — мы в убытке. Вернёшь товар — закрою долг. Закрыть можно позже, жёсткого провала нет — но строку в описи я запомню.",
